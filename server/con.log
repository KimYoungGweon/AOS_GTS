  p        PING
  m0 / m1  SET_MODE MANUAL / AUTO
  on / off SET_PUMP 1 / 0     (P2 MANUAL 의 Pump 버튼)
  t 300 15 SET_TIMES start_ds cycle_ds   (30.0s / 1.5s)
  run/stop AUTO_RUN 1 / 0     (P2 AUTO 의 START/STOP)
  d        DISCONNECT
  q        종료

